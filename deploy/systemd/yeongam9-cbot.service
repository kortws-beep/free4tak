[Unit]
StartLimitIntervalSec=300
StartLimitBurst=5
Description=영암9 코인봇 (cbot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=free4tak
WorkingDirectory=/home/free4tak/k-bot/stock_bot
Environment=PATH=/home/free4tak/k-bot/stock_bot/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/free4tak/k-bot/stock_bot/venv/bin/python3 -u bots/cbot.py

Restart=on-failure
RestartSec=30s

StandardOutput=append:/home/free4tak/k-bot/stock_bot/logs/cbot.log
StandardError=append:/home/free4tak/k-bot/stock_bot/logs/cbot.log

TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
